# Ghostty configuration

# Font settings
font-family = JetBrains Mono
font-size = 15
font-style-bold = true
font-feature = calt
font-feature = liga
adjust-cell-width = -8%

# Clipboard
copy-on-select = true

# Window size (columns x rows)
window-width = 120
window-height = 36

# Cursor settings
cursor-style = block
cursor-style-blink = false

# No progress bar along the top of the window: apps (Claude Code included)
# report progress with OSC 9;4, which Ghostty otherwise draws as a moving bar.
progress-style = false

# Shell settings - ensure zsh loads with login shell for oh-my-zsh
command = /bin/zsh --login

# Theme: Gruvbox Material, medium contrast, dark by default.
# For light/dark following macOS instead:
#   theme = light:Gruvbox Material Light,dark:Gruvbox Material Dark
# Starship, the Claude Code statusline and the dark-ansi Claude Code theme
# use ANSI colour names, so they take their colours from this theme.
theme = Gruvbox Material Dark
