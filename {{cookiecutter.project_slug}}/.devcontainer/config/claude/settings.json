{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "BASH_MAX_OUTPUT_LENGTH": "100000"
  },
  "sandbox": {
    "enabled": false,
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [
      "docker *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-provision-status.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "kokko-ai-config@kokko-ng-kokko-cmds": true,
    "kokko-code-quality@kokko-ng-kokko-cmds": true,
    "kokko-env@kokko-ng-kokko-cmds": true,
    "kokko-git@kokko-ng-kokko-cmds": true,
    "kokko-infra@kokko-ng-kokko-cmds": true,
    "kokko-notifications@kokko-ng-kokko-cmds": true,
    "kokko-validation@kokko-ng-kokko-cmds": true,
    "kokko-viz@kokko-ng-kokko-cmds": true,
    "kokko-janitor@kokko-ng-kokko-janitor": true
  },
  "extraKnownMarketplaces": {
    "kokko-ng-kokko-cmds": {
      "source": {
        "source": "github",
        "repo": "kokko-ng/kokko-skills"
      }
    },
    "kokko-ng-kokko-janitor": {
      "source": {
        "source": "github",
        "repo": "kokko-ng/kokko-janitor-skill"
      }
    }
  },
  "alwaysThinkingEnabled": true
}
