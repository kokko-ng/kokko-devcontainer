{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f*)",
      "Bash(git push * --force)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git gc * --prune*)",
      "Bash(az * delete*)",
      "Bash(az * purge*)",
      "Bash(docker system prune*--volumes*)",
      "Bash(docker volume prune)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(gh repo delete*)",
      "Bash(gh api * DELETE*)",
      "Edit(.devcontainer/devcontainer.json)",
      "Edit(.devcontainer/init-host-*.sh)"
    ]
  },
  "sandbox": {
    "enabled": true
  }
}
