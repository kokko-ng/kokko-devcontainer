{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f*)",
      "Bash(git push * --force)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*--squash*)",
      "Bash(gh pr merge* -s*)",
      "Bash(git merge --squash*)",
      "Bash(git merge * --squash*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git gc * --prune*)",
      "Bash(az * delete*)",
      "Bash(az * purge*)",
      "Bash(docker system prune*--volumes*)",
      "Bash(docker volume prune)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(gh repo delete*)",
      "Bash(gh api * DELETE*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status --show-token*)",
      "Bash(az account get-access-token*)",
      "Read(~/.config/claude-auth/**)",
      "Edit(~/.config/claude-auth/**)",
      "Read(~/.azure/msal_token_cache*)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "sandbox": {
    "enabled": false
  }
}
