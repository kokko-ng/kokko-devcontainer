      "Bash(git push * -f*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git gc * --prune*)",
      "Bash(az * delete*)",
      "Bash(az * purge*)",
      "Bash(docker system prune*--volumes*)",
      "Bash(docker volume prune)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(gh repo delete*)",
      "Bash(gh api * DELETE*)"
