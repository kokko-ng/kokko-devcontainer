.env
.env.*
!.env.example

# Claude Code: per-machine permission grants, and the worktrees that
# `claude --worktree` creates inside the repo (each one is its own checkout).
.claude/settings.local.json
.claude/worktrees/

# Playwright CLI runtime artifacts (browsers, profiles, traces).
.playwright/
.playwright-cli/
.playwright-mcp/
test-results/
playwright-report/

