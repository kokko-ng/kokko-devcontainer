{
  "project_name": "My Project",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "python_version": ["3.14", "3.13", "3.12"],
  "node_version": ["22", "24", "20"],
  "backend_src_dir": "src",
  "frontend_dir": "ui",
  "backend_port": "8000",
  "frontend_port": "5173",
  "include_azure_cli": ["yes", "no"],
  "include_azure_sql_driver": ["yes", "no"],
  "include_docker_in_docker": ["yes", "no"],
  "include_copilot_cli": ["yes", "no"],
  "include_playwright": ["yes", "no"],
  "claude_plugin_roster": ["kokko-ng", "none"],
  "cache_volume_scope": ["shared", "per-project"],
  "git_user_name": "",
  "git_user_email": "",
  "__container_name": "{{ cookiecutter.project_slug }}-dev",
  "__volume_prefix": "{% if cookiecutter.cache_volume_scope == 'per-project' %}{{ cookiecutter.project_slug }}{% else %}devcontainer{% endif %}",
  "_copy_without_render": [
    ".devcontainer/config/zsh/*",
    ".devcontainer/config/claude/*.jq",
    ".devcontainer/config/claude/CLAUDE.md",
    ".devcontainer/config/claude/settings.json",
    ".devcontainer/certs/*"
  ]
}
